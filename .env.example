# ============================================================================
# Portfolio environment variables — COPY to .env and fill in real values.
# NEVER commit a filled .env to git. Only .env.example belongs in the repo.
# ============================================================================

# --- Supabase (Database + Auth) ---
# From: supabase.com -> your project -> Settings -> API
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...           # safe for server use; RLS still applies
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # SERVER ONLY. Bypasses RLS. Never in frontend.

# Admin account (created in Supabase Auth dashboard)
ADMIN_EMAIL=you@example.com

# --- GitHub integration ---
# From: GitHub -> Settings -> Developer settings -> Personal access tokens
#        -> Fine-grained token. Least privilege: Contents=Read-only, Metadata=Read-only,
#        only on the repositories you want synced.
GITHUB_TOKEN=github_pat_...
# Random string you invent; must match the webhook configuration on GitHub.
GITHUB_WEBHOOK_SECRET=choose-a-long-random-string

# --- AI agent (provider-independent; OpenAI-compatible API) ---
# From: Google AI Studio (free tier) at aistudio.google.com, or any OpenAI-compatible provider.
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=AIza...
AI_MODEL=gemini-2.0-flash

# --- Backend API ---
# Public base URL of the deployed API (Vercel). Used by GitHub webhooks docs & CORS.
API_BASE_URL=https://your-api.vercel.app

# --- Frontend (public; baked into the static site at build time) ---
# The ONLY variable the browser bundle may see.
NEXT_PUBLIC_API_URL=https://your-api.vercel.app
